    {
      "parameters": {
        "jsCode": "const text = $('normalizar campos').item.json.texto || '';\n\nconst chunkSize = 600;\nconst overlap = 40;\nconst step = chunkSize - overlap;\n\nconst sections = text.split('##');\n\nconst output = [];\n\nfor (const section of sections) {\n\tconst cleaned = section.trim();\n\n\tif (!cleaned) continue;\n\n\tfor (let start = 0; start < cleaned.length; start += step) {\n\t\toutput.push({\n\t\t\tjson: {\n\t\t\t\tfile_name: $('normalizar campos').item.json.file_name || '',\n\t\t\t\tchunk: cleaned.substring(start, start + chunkSize).trim()\n\t\t\t}\n\t\t});\n\t}\n}\n\nreturn output;"
      },
      "id": "1d8e2fa3-8160-4f2c-9607-6f934f623e68",
