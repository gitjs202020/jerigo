      "parameters": {
        "jsCode": "const fileName = $json.file_name || '';\nlet tipo_documental;\nif (/^FAQ__/i.test(fileName)) tipo_documental = 'faq';\nelse if (/^COSEGURO__/i.test(fileName)) tipo_documental = 'coseguro';\nelse if (/^GENERAL__/i.test(fileName)) tipo_documental = 'general';\nelse throw new Error('Tipo documental no identificado. En testing, usa los prefijos FAQ__, COSEGURO__ o GENERAL__.');\nreturn [{ json: { ...$json, tipo_documental, google_file_id: $('Google Drive Trigger1').item.json.id } }];"
      },
