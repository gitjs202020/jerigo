      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all().map(item => item.json).filter(row => row.google_file_id);\nconst current = $('Clasificar tipo documental').item.json;\nconst hash = String($('hash').item.json.hash || '').trim();\nconst fileId = String(current.google_file_id);\nconst existing = rows.find(row => String(row.google_file_id) === fileId);\nconst storedHash = String(existing?.hash || '').trim();\nconst estado = !existing ? 'nuevo' : storedHash === hash ? 'sin_cambios' : 'actualizado';\nreturn [{ json: { ...current, hash, estado, control_id: existing?.id ?? null } }];"
      },
